# ==========================================
# LLM API Keys (Set whichever one you have)
# ==========================================

# 1. Google Gemini (Recommended - Free Tier Available: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq (Recommended - Free Tier & Ultra Fast: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenAI (GPT-4o, GPT-4o-mini: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# 4. Anthropic Claude (Claude 3.5 Sonnet / Haiku: https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Local Ollama URL (default is http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
